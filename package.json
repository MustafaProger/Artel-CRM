{
  "name": "artel-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "tsx --test tests/api*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web/src server tests vite.config.ts",
    "test": "npm run test:api",
    "test:shipments-ui": "node scripts/verify_shipments_excel.mjs",
    "test:directories-ui": "node scripts/verify_directories.mjs",
    "test:azs-ui": "node scripts/verify_azs.mjs",
    "test:work-ui": "node scripts/verify_work.mjs",
    "test:auth-ui": "node scripts/verify_navigation_auth.mjs",
    "test:requirements-ui": "node --import tsx scripts/verify_requirements.mjs",
    "test:design-ui": "node scripts/verify_apple.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.0"
  }
}
