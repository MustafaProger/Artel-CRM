# Server-side Checko API key. Never use a VITE_ prefix for this value.
CHECKO_API_KEY=

# Optional absolute directory for mutable operations and company metadata.
# Defaults to data/local-operations; the source data/local-xlsx-final is immutable.
# Use a temporary directory for browser QA and integration experiments.
# ARTEL_STORE_DIR=/absolute/path/to/local-operations
