# Server-side Checko API key. Never use a VITE_ prefix for this value.
CHECKO_API_KEY=

# Optional absolute directory for mutable operations and company metadata.
# Defaults to data/local-operations; the source data/local-xlsx-final is immutable.
# Use a temporary directory for browser QA and integration experiments.
# ARTEL_STORE_DIR=/absolute/path/to/local-operations

# Production only: set a strong one-time bootstrap secret in Vercel server env.
# Required for creating the first director over HTTPS; remove after setup.
# ARTEL_SETUP_TOKEN=

# Web Push: generate once with web-push.generateVAPIDKeys(). Never commit real keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://artel-crm.vercel.app
# PUSH_SCHEDULE_ENABLED=true
# CRON_SECRET=

# Bank statement access. Server only; see docs/banking.md. No real values here.
# Enable only after the first successful live verification and scheduler deployment.
ARTEL_BANK_SYNC_ENABLED=false
# ARTEL_BANK_ENCRYPTION_KEY=<64 hex characters generated securely>
# For each prefix ARTEL_BANK_SBER_NK and ARTEL_BANK_SBER_ARTEL:
# ARTEL_BANK_SBER_NK_ACCOUNTS=[{"number":"<20 digits>","currency":"RUB"}]
# ARTEL_BANK_SBER_NK_CLIENT_ID=
# ARTEL_BANK_SBER_NK_CLIENT_SECRET=
# ARTEL_BANK_SBER_NK_REFRESH_TOKEN=
# ARTEL_BANK_SBER_NK_TLS_CERT_PATH=/secure/location/client-cert.pem
# ARTEL_BANK_SBER_NK_TLS_KEY_PATH=/secure/location/client-key.pem
# ARTEL_BANK_SBER_NK_TLS_CA_PATH=/secure/location/ca-chain.pem
# On serverless hosts use TLS_CERT_BASE64 / TLS_KEY_BASE64 / TLS_CA_BASE64 instead.
# ARTEL_BANK_TBANK_NK_ACCOUNTS=[{"number":"<20 digits>","currency":"RUB"}]
# ARTEL_BANK_TBANK_NK_TOKEN=
# ARTEL_BANK_TBANK_NK_WEBHOOK_TOKEN=
