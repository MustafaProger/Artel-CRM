# Server-side Checko API key. Never use a VITE_ prefix for this value.
CHECKO_API_KEY=

# Yandex Tiles API key: server-only, never expose with a VITE_ prefix.
# Obtain the separate Tiles API service and restrict the key in Yandex.
# The proxy always supplies Referer: https://artel-crm.online/.
# Never commit a real value. No fallback provider is configured.
# YANDEX_TILES_API_KEY=
# Optional server-only base64url secret for the Yandex WithTTL signature restriction.
# Enable WithTTL in the Tiles key settings; never disclose this secret to browsers.
# YANDEX_TILES_SIGNING_SECRET=

# Optional absolute directory for mutable operations and company metadata.
# Defaults to data/local-operations; the source data/local-xlsx-final is immutable.
# Use a temporary directory for browser QA and integration experiments.
# ARTEL_STORE_DIR=/absolute/path/to/local-operations

# Production only: set a strong one-time bootstrap secret in Vercel server env.
# Required for creating the first director over HTTPS; remove after setup.
# ARTEL_SETUP_TOKEN=

# Web Push: generate once with web-push.generateVAPIDKeys(). Never commit real keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://artel-crm.vercel.app
# PUSH_SCHEDULE_ENABLED=true
# CRON_SECRET=

# Bank statement access. Server only; see docs/banking.md. No real values here.
# Enable only after the first successful live verification and scheduler deployment.
ARTEL_BANK_SYNC_ENABLED=false
# ARTEL_BANK_TBANK_NK_ACCOUNTS=[{"number":"<20 digits>","currency":"RUB"}]
# ARTEL_BANK_TBANK_NK_TOKEN=
# ARTEL_BANK_TBANK_NK_WEBHOOK_TOKEN=

# Direct NK ETRN only: separate from the ordinary ARTEL sender configuration.
# Set the real NK certificate holder's details server-side after verification.
# SABY_NK_CONSIGNMENT_SIGNER_JSON={"surname":"<surname>","name":"<name>","patronymic":"<patronymic>","position":"<position>"}
# SABY_NK_REGULATORY_INSTRUCTIONS=<approved transport requirements>

# Server-only key for viewing passwords set after this feature is enabled.
# Generate 32 random bytes as 64 hexadecimal characters; preserve it across releases.
# ARTEL_ACCOUNT_PASSWORD_KEY=
