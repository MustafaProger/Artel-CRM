# Server-side Checko API key. Never use a VITE_ prefix for this value.
CHECKO_API_KEY=

# Optional absolute directory for mutable operations and company metadata.
# Defaults to data/local-operations; the source data/local-xlsx-final is immutable.
# Use a temporary directory for browser QA and integration experiments.
# ARTEL_STORE_DIR=/absolute/path/to/local-operations

# Production only: set a strong one-time bootstrap secret in Vercel server env.
# Required for creating the first director over HTTPS; remove after setup.
# ARTEL_SETUP_TOKEN=

# Web Push: generate once with web-push.generateVAPIDKeys(). Never commit real keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://artel-crm.vercel.app
# PUSH_SCHEDULE_ENABLED=true
# CRON_SECRET=
