+    await card(55).getByRole('button', { name: 'Возобновить обмен', exact: true }).waitFor();
+    await card(55).getByRole('button', { name: 'Удалить рейс', exact: true }).click();
+    await dialog.getByText(/Рейс связан с документами Saby/).waitFor();
