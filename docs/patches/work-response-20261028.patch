-.work-task-row{display:flex;align-items:flex-start;gap:4px;min-width:0}.work-task-row>.work-card{flex:1;min-width:0}.work-record-row{min-width:0}.work-task-check{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-height:44px;cursor:pointer}.work-task-check input{width:20px;height:20px;margin:0;accent-color:var(--color-primary,#3671c9);cursor:pointer}.work-task-check:has(:focus-visible){outline:2px solid var(--color-primary,#3671c9);outline-offset:1px;border-radius:7px}.work-task-check:has(:disabled){cursor:default;opacity:.6}
+/* One aligned row owns its checkbox, content and status; no nested card borders. */
+.work-page .work-task-row{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:10px;align-items:start;min-width:0;padding:10px 16px;border-bottom:1px solid var(--border,#e4e7eb)}
+.work-page .work-task-row:last-child{border-bottom:0}
+.work-task-content{min-width:0}
+.work-page .work-task-open{display:flex;flex-direction:column;gap:5px;width:100%;min-width:0;padding:10px 0;border:0;border-radius:6px;box-shadow:none;background:none;text-align:left;color:var(--text,#1d1d1f);font:inherit;cursor:pointer}
+.work-page .work-task-open:disabled{opacity:1;color:var(--text,#1d1d1f);cursor:wait}
+.work-page .work-task-open strong{font-size:14px;line-height:24px;font-weight:600;overflow-wrap:anywhere}
