+    if (f.id && (!old || seen.has(old.id))) return fail('Файл не принадлежит этой карточке или указан дважды.');
+    if (old) seen.add(old.id);
+    const title = text(f.title, 'Название файла'), expiresOn = expiry(f.expiresOn);
