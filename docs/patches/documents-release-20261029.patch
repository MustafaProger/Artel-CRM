+    if (typeof encoded !== 'string' || !encoded.length || encoded.length > Math.ceil(documentMaxBytes / 3) * 4 || !/^[A-Za-z0-9+/]*={0,2}$/.test(encoded)) return fail('Выберите непустой файл до 5 МБ.');
