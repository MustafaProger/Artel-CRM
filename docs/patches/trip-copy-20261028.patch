+  assert.equal(tripCopyText(trip, data), '23.10\nКомплекс Ойл 77000\nДТ\n4000 л Ип Киртока 70,00\n5500 л ооо спс 73,00\n8000 л ао АиФ 72,00\nПётр 8000+7000+8000')
