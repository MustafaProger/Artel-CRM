+function Heading({ action = false }: { action?: boolean }) { return <div className="loading-skeleton__heading"><SkeletonBar size="title"/>{action && <SkeletonBar className="loading-skeleton__button"/>}</div> }
+function Rows({ count, avatar = false, amount = false }: { count: number; avatar?: boolean; amount?: boolean }) { return <div className="loading-skeleton__rows">{repeat(count, index => <div className="loading-skeleton__row" key={index}>{avatar && <SkeletonBar className="loading-skeleton__avatar"/>}<Copy/>{amount && <SkeletonBar className="loading-skeleton__amount"/>}</div>)}</div> }
+function Table({ count, columns = 5 }: { count: number; columns?: number }) { return <div className="loading-skeleton__table" style={{ '--skeleton-columns': columns } as CSSProperties}><div className="loading-skeleton__table-heading">{repeat(columns, index => <SkeletonBar key={index}/>)}</div>{repeat(count, row => <div className="loading-skeleton__table-row" key={row}>{repeat(columns, index => <SkeletonBar key={index}/>)}</div>)}</div> }
+function RequestCards({ count, trip = false }: { count: number; trip?: boolean }) {
+  if (!trip) return <div className="loading-skeleton__request-grid">{repeat(count, index => <Surface className="loading-skeleton__request-card" key={index}><div className="loading-skeleton__request-heading"><SkeletonBar size="title"/><SkeletonBar className="loading-skeleton__amount"/></div><div className="loading-skeleton__request-price"><SkeletonBar/><SkeletonBar/></div><div className="loading-skeleton__request-details">{repeat(3, detail => <div key={detail}><SkeletonBar size="short"/><SkeletonBar/></div>)}</div><div className="loading-skeleton__request-footer"><div className="loading-skeleton__request-link"><SkeletonBar/></div><div className="loading-skeleton__request-actions"><SkeletonBar className="loading-skeleton__button"/><SkeletonBar className="loading-skeleton__button"/></div></div></Surface>)}</div>
+  return <div className="loading-skeleton__request-grid">{repeat(count, index => <Surface className="loading-skeleton__request" key={index}><div className="loading-skeleton__row"><Copy/><SkeletonBar className="loading-skeleton__amount"/></div><div className="loading-skeleton__route"><Copy lines={3}/><Copy/></div><div className="loading-skeleton__footer"><SkeletonBar size="short"/><div className="loading-skeleton__actions"><SkeletonBar className="loading-skeleton__button"/></div></div></Surface>)}</div>
