+function Operator({ count }: { count: number }) { return <><Heading/><div className="loading-skeleton__operator-filters">{repeat(6, index => <div key={index}><SkeletonBar size="short"/><SkeletonBar size="field"/></div>)}</div><div className="loading-skeleton__operator-table"><Surface><Table count={count} columns={9}/></Surface></div><div className="loading-skeleton__operator-cards">{repeat(3, index => <Surface key={index}><div className="loading-skeleton__row"><Copy/><SkeletonBar className="loading-skeleton__button"/></div><div className="loading-skeleton__operator-card-body"><SkeletonBar className="loading-skeleton__status"/><div className="loading-skeleton__bank-totals"><Copy/><Copy/></div><SkeletonBar size="field"/><Copy lines={3}/></div></Surface>)}</div></> }
