+type Layout = 'list' | 'cards' | 'table' | 'overview' | 'form' | 'work' | 'work-calendar' | 'requests' | 'trips' | 'process' | 'map' | 'banks' | 'cabinet' | 'china' | 'invoice' | 'accounts' | 'documents' | 'operator' | 'sber'
+type Props = { label?: string; variant?: Layout; rows?: number; toolbar?: boolean; className?: string }
+
+/** A decorative line: no fabricated amounts, buttons, or selectable records. */
+export function SkeletonBar({ size = '', className = '' }: { size?: 'short' | 'title' | 'value' | 'field' | ''; className?: string }) {
+  return <span aria-hidden="true" className={`loading-skeleton__bar${size ? ` loading-skeleton__bar--${size}` : ''} ${className}`}/>
+}
+const repeat = (count: number, render: (index: number) => ReactNode) => Array.from({ length: count }, (_, index) => render(index))
+function Copy({ lines = 2 }: { lines?: number }) { return <div className="loading-skeleton__copy"><SkeletonBar size="title"/>{repeat(lines - 1, index => <SkeletonBar key={index} size={index % 2 ? 'short' : ''}/>)}</div> }
