+function Invoice() { return <><Surface className="loading-skeleton__invoice-create"><Heading/><div className="loading-skeleton__invoice-description"><SkeletonBar/><SkeletonBar/></div><div className="loading-skeleton__invoice-fields">{repeat(4, index => <div key={index}><SkeletonBar size="short"/><SkeletonBar size="field"/></div>)}</div><div className="loading-skeleton__invoice-hints"><SkeletonBar/><SkeletonBar size="short"/></div><div className="loading-skeleton__invoice-action"><SkeletonBar size="short"/><SkeletonBar className="loading-skeleton__button"/></div></Surface><Surface className="loading-skeleton__invoice-history"><div className="loading-skeleton__invoice-history-heading"><SkeletonBar size="title"/><SkeletonBar/></div>{repeat(2, index => <div className="loading-skeleton__invoice-record" key={index}><div className="loading-skeleton__invoice-record-heading"><SkeletonBar/><SkeletonBar/><SkeletonBar className="loading-skeleton__status"/></div><div className="loading-skeleton__invoice-fields">{repeat(4, field => <Copy key={field}/>)}</div><div className="loading-skeleton__invoice-record-actions"><SkeletonBar size="short"/><SkeletonBar className="loading-skeleton__button"/></div></div>)}<div className="loading-skeleton__invoice-privacy"><SkeletonBar/></div></Surface></> }
